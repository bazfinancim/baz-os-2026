# ─── Base44 ───────────────────────────────────────────────────────────────
# מפתח API לשרת בלבד — לא NEXT_PUBLIC_
BASE44_API_KEY=your_base44_api_key_here

# ─── N8N (Webhook URLs — לא סודיים, אבל ניתן לשנות) ─────────────────────
# השאר ריק כדי להשתמש בברירת המחדל: https://n8n.baz-f.co.il/webhook/baz-os-logger
BAZ_OS_WORKFLOW_TRIGGER_WEBHOOK_URL=

# ─── AI Providers (אופציונלי) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_BACKUP=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-2.5-flash

# ─── WhatsApp / Meta (אופציונלי) ──────────────────────────────────────────
META_ACCESS_TOKEN=
META_PHONE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# ─── Safety (אופציונלי) ────────────────────────────────────────────────────
PROTECTED_MODE=OFF
SESSION_PIN=
